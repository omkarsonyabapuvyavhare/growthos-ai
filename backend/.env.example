AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=2
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
YOUTUBE_API_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=10
YOUTUBE_REQUEST_TIMEOUT_SECONDS=10
DATABASE_URL=sqlite:///./growthos.db
# Local CORS only (comma-separated). Same-origin Vercel prod does not need this.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3002
FAISS_INDEX_PATH=./data/faiss_index/index.faiss
FAISS_METADATA_PATH=./data/faiss_index/metadata.json
FAISS_CATALOG_INDEX_PATH=./data/faiss_catalog/index.faiss
FAISS_CATALOG_METADATA_PATH=./data/faiss_catalog/metadata.json
RESOURCE_CATALOG_PATH=./data/sample_resources.json
