# GrowthOS AI frontend → FastAPI backend
#
# Local development (separate uvicorn process):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
#
# Vercel production / preview (same-domain Services rewrite):
#   NEXT_PUBLIC_API_BASE_URL=/api/backend
#
# Match the local value to wherever you start the API, then restart `npm run dev`.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
