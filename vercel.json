{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 300
        }
      },
      "rewrites": [
        {
          "source": "/api/backend",
          "destination": "/"
        },
        {
          "source": "/api/backend/:path*",
          "destination": "/:path*"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/backend",
      "destination": {
        "service": "backend"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/"
        }
      ]
    },
    {
      "source": "/api/backend/:path*",
      "destination": {
        "service": "backend"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/:path*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
